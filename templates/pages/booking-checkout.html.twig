{% extends 'layout/user.html.twig' %}

{% block content %}
    <div class="max-w-2xl mx-auto">
        <div class="bg-white rounded-lg shadow-lg p-8 border border-gray-200">
            <div class="text-center mb-8">
                <div class="text-6xl mb-4">✅</div>
                <h1 class="text-3xl font-bold text-gray-900 mb-2">Réservation en cours de traitement</h1>
                <p class="text-gray-600">Votre demande a été reçue avec succès !</p>
            </div>

            <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-8">
                <p class="text-sm text-blue-800">
                    <strong>Numéro de réservation :</strong> #{{ booking_id }}
                </p>
            </div>

            <div class="space-y-4 mb-8 pb-8 border-b border-gray-200">
                <h2 class="text-xl font-bold text-gray-900">Prochaines étapes</h2>
                <div class="space-y-3">
                    <div class="flex gap-4">
                        <div class="flex-shrink-0 font-bold text-brand">1</div>
                        <div>
                            <p class="font-semibold text-gray-900">Attente de confirmation de l'hôte</p>
                            <p class="text-sm text-gray-600">Vous recevrez une notification dès que l'hôte aura confirmé ou refusé votre réservation.</p>
                        </div>
                    </div>
                    <div class="flex gap-4">
                        <div class="flex-shrink-0 font-bold text-brand">2</div>
                        <div>
                            <p class="font-semibold text-gray-900">Finaliser le paiement</p>
                            <p class="text-sm text-gray-600">Une fois confirmée, vous finaliserez le paiement de manière sécurisée via Stripe.</p>
                        </div>
                    </div>
                    <div class="flex gap-4">
                        <div class="flex-shrink-0 font-bold text-brand">3</div>
                        <div>
                            <p class="font-semibold text-gray-900">Recevoir les détails d'accès</p>
                            <p class="text-sm text-gray-600">L'hôte vous enverra les détails d'entrée et les informations de contact.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="space-y-4 mb-8 pb-8 border-b border-gray-200">
                <h2 class="text-xl font-bold text-gray-900">Détails de la réservation</h2>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <p class="text-sm text-gray-600">Arrivée</p>
                        <p class="font-semibold text-gray-900">17 juin 2026</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-600">Départ</p>
                        <p class="font-semibold text-gray-900">22 juin 2026</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-600">Durée</p>
                        <p class="font-semibold text-gray-900">5 nuits</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-600">Voyageurs</p>
                        <p class="font-semibold text-gray-900">4 personnes</p>
                    </div>
                </div>
            </div>

            <div class="space-y-4 mb-8">
                <h2 class="text-xl font-bold text-gray-900">Résumé du coût</h2>
                <div class="bg-gray-50 p-4 rounded-lg space-y-2 text-sm">
                    <div class="flex justify-between">
                        <span class="text-gray-600">125 € × 5 nuits</span>
                        <span class="text-gray-900 font-semibold">625 €</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">Frais de nettoyage</span>
                        <span class="text-gray-900 font-semibold">50 €</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">Frais de service</span>
                        <span class="text-gray-900 font-semibold">75 €</span>
                    </div>
                    <div class="border-t border-gray-200 pt-2 flex justify-between font-semibold">
                        <span class="text-gray-900">Total</span>
                        <span class="text-gray-900">750 €</span>
                    </div>
                </div>
            </div>

            <div class="flex flex-col sm:flex-row gap-4">
                <a href="{{ path('home') }}" class="flex-1 px-6 py-3 bg-gray-100 hover:bg-gray-200 text-gray-900 font-semibold rounded-lg transition text-center">
                    Continuer la navigation
                </a>
                <a href="{{ path('user_dashboard') }}" class="flex-1 px-6 py-3 bg-brand hover:bg-brandHover text-white font-semibold rounded-lg transition text-center">
                    Voir mes réservations
                </a>
            </div>

            <div class="mt-8 p-4 bg-gray-50 rounded-lg text-sm text-gray-600">
                <p class="mb-2">
                    <strong>Besoin d'aide ?</strong> Contactez notre support à <a href="mailto:support@plateforme.com" class="text-brand hover:underline">support@plateforme.com</a> ou appelez le <strong>+33 1 23 45 67 89</strong>
                </p>
                <p>Consultez vos réservations dans <a href="{{ path('user_dashboard') }}" class="text-brand hover:underline">votre profil</a></p>
            </div>
        </div>
    </div>
{% endblock %}

