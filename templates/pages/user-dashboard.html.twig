{% extends 'layout/user.html.twig' %}

{% block content %}
    <div class="mb-8">
        <h1 class="text-4xl font-bold text-gray-900 mb-2">Mes réservations</h1>
        <p class="text-gray-600">Gérez vos recherches et vos réservations en cours</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 mb-8">
        <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
            <div class="text-3xl mb-2">📅</div>
            <p class="text-gray-600 text-sm">En attente</p>
            <p class="text-3xl font-bold text-gray-900">2</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
            <div class="text-3xl mb-2">✅</div>
            <p class="text-gray-600 text-sm">Confirmées</p>
            <p class="text-3xl font-bold text-gray-900">5</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
            <div class="text-3xl mb-2">🏠</div>
            <p class="text-gray-600 text-sm">Actuelles</p>
            <p class="text-3xl font-bold text-gray-900">1</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
            <div class="text-3xl mb-2">✨</div>
            <p class="text-gray-600 text-sm">À venir</p>
            <p class="text-3xl font-bold text-gray-900">3</p>
        </div>
    </div>

    <div class="mb-8 flex gap-2">
        <button class="px-4 py-2 bg-brand text-white font-semibold rounded-lg hover:bg-brandHover transition">
            Toutes
        </button>
        <button class="px-4 py-2 border border-gray-300 text-gray-900 font-semibold rounded-lg hover:bg-gray-50 transition">
            En attente
        </button>
        <button class="px-4 py-2 border border-gray-300 text-gray-900 font-semibold rounded-lg hover:bg-gray-50 transition">
            Confirmées
        </button>
        <button class="px-4 py-2 border border-gray-300 text-gray-900 font-semibold rounded-lg hover:bg-gray-50 transition">
            Passées
        </button>
    </div>

    <div class="space-y-4">
        {% for reservation in reservations %}
            <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm hover:shadow-md transition">
                <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
                    <div>
                        <img src="{{ reservation.property.media[0].fileUrl }}" alt="Propriété" class="w-full h-32 object-cover rounded-lg">
                    </div>
                    <div class="sm:col-span-2">
                        <h3 class="font-bold text-lg text-gray-900 mb-1">{{ reservation.property.title }}</h3>
                        <p class="text-gray-600 text-sm mb-3">📍 {{ reservation.property.address.city }}, {{ reservation.property.address.country }}</p>
                        <div class="space-y-1 text-sm">
                            <p><span class="text-gray-600">Arrivée :</span> <span class="font-semibold text-gray-900">{{ reservation.checkinDate | date('d/m/Y') }}</span></p>
                            <p><span class="text-gray-600">Départ :</span> <span class="font-semibold text-gray-900">{{ reservation.checkoutDate | date('d/m/Y') }}</span></p>
                        </div>
                    </div>
                    <div class="text-right">
                        <div class="mb-4">
{#                            {% if i <= 2 %}#}
{#                                <span class="inline-block bg-yellow-100 text-yellow-800 text-xs font-semibold px-3 py-1 rounded-full">En attente</span>#}
{#                            {% else %}#}
{#                                <span class="inline-block bg-green-100 text-green-800 text-xs font-semibold px-3 py-1 rounded-full">Confirmée</span>#}
{#                            {% endif %}#}
                        </div>
                        <p class="text-gray-600 text-sm mb-3">Total TTC</p>
                        <p class="text-2xl font-bold text-gray-900 mb-3">{{ reservation.totalPrice }} €</p>
                        <div class="space-y-2">
                            <button class="w-full px-3 py-2 text-sm border border-gray-300 text-gray-900 font-semibold rounded-lg hover:bg-gray-50 transition">
                                Détails
                            </button>
{#                            {% if i <= 2 %}#}
{#                                <button class="w-full px-3 py-2 text-sm bg-red-100 text-red-800 font-semibold rounded-lg hover:bg-red-200 transition">#}
{#                                    Annuler#}
{#                                </button>#}
{#                            {% endif %}#}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="mt-8 text-center">
        <a href="{{ path('search') }}" class="inline-block px-6 py-3 bg-brand hover:bg-brandHover text-white font-semibold rounded-lg transition">
            Rechercher d'autres propriétés
        </a>
    </div>
{% endblock %}

