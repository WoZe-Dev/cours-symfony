<a href="{{ path('logement_detail', {id: logement.id}) }}" class="group cursor-pointer block hover:no-underline">
    <div class="relative aspect-square w-full overflow-hidden rounded-xl mb-3">
        <img class="h-full w-full object-cover group-hover:scale-105 transition duration-300" src="{{ logement.media[0].fileUrl }}" alt="Villa">
        <button type="button" class="absolute top-3 right-3 text-white text-xl drop-shadow-md hover:scale-110 transition">
            <i class="fa-regular fa-heart"></i>
        </button>
    </div>
    <div class="flex justify-between items-start">
        <h3 class="font-bold text-sm text-gray-900">{{ logement.title }}</h3>
        <div class="flex items-center space-x-1 text-sm">
            <i class="fa-solid fa-star text-xs"></i>
            <span>{{ logement.maxGuests }}</span>
        </div>
    </div>
    <p class="text-gray-500 text-sm">{{ logement.description }}</p>
    <p class="text-gray-500 text-sm mb-1">10-15 juil.</p>
    <p class="text-sm font-semibold"><span class="font-bold">{{ logement.pricePerNight }} €</span> nuit</p>
</a>
